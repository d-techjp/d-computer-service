NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=v1

DB_URL=postgresql://postgres:postgres@localhost:5432/d_computer_service
DB_RUN_MIGRATIONS=false

JWT_SECRET=rampo-recret
JWT_EXPIRES_IN=1d

REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- Cloudflare R2 (lưu ảnh sản phẩm / bài viết) ----------
# Account ID: xem ở Cloudflare Dashboard > R2 > Overview
R2_ACCOUNT_ID=
# Tạo tại Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=d-computer-service
# Domain public để trả URL cho client — bật Public Access cho bucket rồi lấy domain *.r2.dev,
# hoặc gắn custom domain riêng (khuyến nghị khi lên production)
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# ---------- Stripe (thanh toán thẻ / PayPay qua Stripe Checkout) ----------
# Dashboard > Developers > API keys. Dùng sk_test_... khi dev. Để trống = chỉ có COD.
STRIPE_SECRET_KEY=
# Dashboard > Developers > Webhooks (endpoint: <API_URL>/api/v1/payments/stripe/webhook),
# hoặc chạy local: stripe listen --forward-to localhost:3000/api/v1/payments/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Phải bật tương ứng trong Dashboard > Settings > Payment methods
STRIPE_PAYMENT_METHOD_TYPES=card,paypay
# Hết thời gian này mà chưa trả tiền thì đơn tự huỷ (30 -> 1440 phút)
STRIPE_CHECKOUT_EXPIRES_MINUTES=30
# Domain storefront — Stripe chuyển khách về đây sau khi thanh toán
STOREFRONT_URL=http://localhost:3000

# ---------- Email (Resend) — xác nhận đơn, báo đơn mới, báo đổi trạng thái ----------
# resend.com > API Keys. Để trống = không gửi email nào.
RESEND_API_KEY=
# Phải thuộc domain đã Verified trên Resend (thêm bản ghi SPF/DKIM vào DNS Cloudflare)
MAIL_FROM=D-Tech <order@d-techjp.com>
# Khách bấm "Trả lời" sẽ gửi về đây (vd hộp thư chuyển tiếp bằng Cloudflare Email Routing)
MAIL_REPLY_TO=support@d-techjp.com
# Nhận email báo có đơn mới — nhiều địa chỉ cách nhau bởi dấu phẩy
SHOP_NOTIFY_EMAILS=
# Gốc trang quản trị — email báo đơn mới có link mở thẳng đơn
ADMIN_URL=http://localhost:3000
